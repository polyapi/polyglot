# Go build output. /polyapi is the repo-root binary from
# `go build -o polyapi`; it must be anchored so Git still tracks
# the command package at src/cmd/polyapi.
/polyapi
/polyapi.exe
*.exe
*.test
*.out
vendor/

# These are backup files generated by editors
*~
*.swp

# JetBrains
#  A JetBrains-specific template is maintained in a separate JetBrains.gitignore
#  at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#.idea/

.poly/
.DS_Store
target/
